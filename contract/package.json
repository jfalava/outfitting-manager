{
  "name": "@outfitting/contract",
  "version": "0.15.3",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test",
    "fix": "bun run lint:fix && bun run format",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "test": "vitest run",
    "typecheck": "effect-tsgo tsrs --noEmit"
  },
  "dependencies": {
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@oxlint/plugins": "catalog:build",
    "@types/node": "catalog:types",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build",
    "tsrs": "catalog:build",
    "vitest": "catalog:build"
  }
}
