{
  "name": "@outfitting/docs",
  "version": "0.15.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "astro build",
    "check": "bun typecheck && bun lint:fix",
    "dev": "astro dev",
    "format": "prettier --write \"src/**/*.{astro,mdx,md}\" && oxfmt",
    "format:check": "prettier --check \"src/**/*.{astro,mdx,md}\" && oxfmt --check",
    "lint": "bun run lint:oxlint && bun run lint:astro && bun run lint:docs",
    "lint:astro": "eslint \"src/**/*.astro\"",
    "lint:astro:fix": "eslint \"src/**/*.astro\" --fix",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "lint:fix": "bun run lint:oxlint:fix && bun run lint:astro:fix && bun run lint:docs:fix",
    "lint:oxlint": "astro sync && oxlint --type-aware --type-check src",
    "lint:oxlint:fix": "astro sync && oxlint --type-aware --type-check src --fix",
    "preview": "astro preview",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.20.2",
    "@fontsource/google-sans-code": "5.3.2",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/zilla-slab": "5.3.0",
    "@iconify-json/ph": "1.2.2",
    "astro": "7.4.13",
    "astro-icon": "1.2.0",
    "astro-og-canvas": "0.13.3",
    "canvaskit-wasm": "0.42.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler": "4.0.0",
    "@oxlint/plugins": "catalog:build",
    "@tailwindcss/vite": "4.3.5",
    "@typescript-eslint/parser": "8.74.0",
    "cross-spawn": "7.0.6",
    "eslint": "10.15.0",
    "eslint-plugin-astro": "3.2.2",
    "oxlint": "catalog:build",
    "pagefind": "1.6.0",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "1.1.2",
    "satteri": "0.11.7",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  },
  "optionalDependencies": {
    "@bruits/satteri-darwin-arm64": "0.11.7",
    "@bruits/satteri-linux-arm64-gnu": "0.11.7",
    "@bruits/satteri-linux-x64-gnu": "0.11.7",
    "@bruits/satteri-win32-x64-msvc": "0.11.7"
  }
}
