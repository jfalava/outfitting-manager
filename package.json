{
  "name": "@outfitting/manager-monorepo",
  "workspaces": {
    "packages": [
      "api",
      "cli",
      "contract",
      "docs",
      "iac",
      "router"
    ],
    "catalogs": {
      "types": {
        "@types/node": "26.6.11"
      },
      "build": {
        "bun-types": "1.4.5",
        "@oxlint/plugins": "1.95.0",
        "oxlint": "1.95.0",
        "oxfmt": "0.80.0",
        "vitest": "5.1.2",
        "tsrs": "7.1.0-beta.tsrs5",
        "wrangler": "4.128.0"
      },
      "backend": {
        "hono": "4.13.23"
      },
      "cloudflare": {
        "@cloudflare/workers-types": "5.20261128.1"
      },
      "effect": {
        "effect": "4.1.6",
        "@effect/platform-bun": "4.1.6",
        "@effect/platform-node": "4.1.6",
        "@effect/platform-node-shared": "4.1.6"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run ci:build",
    "ci:build": "bun run lint:deploy && bun run typecheck:deploy && bun run test:deploy",
    "ci:deploy": "bun run --filter @outfitting/iac ci:deploy",
    "deploy": "bun run --filter @outfitting/iac deploy",
    "destroy": "bun run --filter @outfitting/iac destroy",
    "format": "oxfmt",
    "format:global": "bun run --filter @outfitting/api --filter @outfitting/cli --filter @outfitting/contract --filter @outfitting/docs --filter @outfitting/iac --filter @outfitting/router format",
    "lint:deploy": "bun run --filter @outfitting/api --filter @outfitting/contract --filter @outfitting/docs --filter @outfitting/iac --filter @outfitting/router lint",
    "lint:global": "bun run --filter @outfitting/api --filter @outfitting/cli --filter @outfitting/contract --filter @outfitting/docs --filter @outfitting/iac --filter @outfitting/router lint",
    "plan": "bun run --filter @outfitting/iac plan",
    "test:api": "bun run --filter @outfitting/api test",
    "test:cli": "bun run --filter @outfitting/cli test",
    "test:contract": "bun run --filter @outfitting/contract test",
    "test:iac": "bun run --filter @outfitting/iac test",
    "test:router": "bun run --filter @outfitting/router test",
    "test:deploy": "bun run --filter @outfitting/api --filter @outfitting/contract --filter @outfitting/iac --filter @outfitting/router test",
    "typecheck:deploy": "bun run --filter @outfitting/api --filter @outfitting/contract --filter @outfitting/docs --filter @outfitting/iac --filter @outfitting/router typecheck",
    "typecheck:global": "bun run --filter @outfitting/api --filter @outfitting/cli --filter @outfitting/contract --filter @outfitting/docs --filter @outfitting/iac --filter @outfitting/router typecheck",
    "prepare": "effect-tsgo patch --no-typescript --tsrs --oxlint"
  },
  "devDependencies": {
    "@effect/tsgo": "0.74.1",
    "@oxlint/plugins": "catalog:build",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build",
    "tsrs": "catalog:build"
  }
}
