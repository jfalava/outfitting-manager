{
  "name": "@outfitting/manager-monorepo",
  "workspaces": {
    "packages": [
      "api",
      "cli",
      "contract",
      "docs",
      "iac",
      "router"
    ],
    "catalogs": {
      "types": {
        "@types/node": "26.6.11"
      },
      "build": {
        "@effect/tsgo": "0.74.1",
        "@oxlint/plugins": "1.95.0",
        "bun-types": "1.4.5",
        "oxfmt": "0.80.0",
        "oxlint": "1.95.0",
        "tsrs": "7.1.0-beta.tsrs5",
        "vitest": "5.1.2",
        "wrangler": "4.128.0"
      },
      "backend": {
        "hono": "4.13.23"
      },
      "cloudflare": {
        "@cloudflare/workers-types": "5.20261128.1"
      },
      "effect": {
        "effect": "4.1.6",
        "@effect/platform-bun": "4.1.6",
        "@effect/platform-node": "4.1.6",
        "@effect/platform-node-shared": "4.1.6"
      }
    }
  },
  "type": "module",
  "scripts": {
    "check": "bun run --workspaces check && oxfmt --check",
    "ci:build": "bun run check",
    "ci:deploy": "bun run --cwd iac ci:deploy",
    "deploy": "bun run --cwd iac deploy",
    "destroy": "bun run --cwd iac destroy",
    "dev": "bun run --cwd iac dev",
    "fix": "bun run --workspaces --if-present fix && oxfmt",
    "format": "bun run --workspaces --if-present format && oxfmt",
    "format:check": "bun run --workspaces --if-present format:check && oxfmt --check",
    "lint": "bun run --workspaces --if-present lint",
    "plan": "bun run --cwd iac plan",
    "prepare": "effect-tsgo patch --no-typescript --tsrs --oxlint",
    "test": "bun run --workspaces --if-present test",
    "typecheck": "bun run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:build",
    "@oxlint/plugins": "catalog:build",
    "oxfmt": "catalog:build",
    "oxlint": "catalog:build",
    "tsrs": "catalog:build"
  },
  "packageManager": "bun@1.4.5"
}
